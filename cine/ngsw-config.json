{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "cartelera",
      "urls": [
        "https://igzqqxtnogghgdqlqhgf.supabase.co/rest/v1/peliculas*",
        "https://igzqqxtnogghgdqlqhgf.supabase.co/rest/v1/funciones*",
        "https://igzqqxtnogghgdqlqhgf.supabase.co/rest/v1/resenas*",
        "https://igzqqxtnogghgdqlqhgf.supabase.co/rest/v1/precios_butaca*"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "4s"
      }
    },
    {
      "name": "imagenes",
      "urls": [
        "https://igzqqxtnogghgdqlqhgf.supabase.co/storage/v1/object/public/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 150,
        "maxAge": "7d"
      }
    }
  ]
}
